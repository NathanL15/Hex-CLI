{
    "version": "1.7.0",
    "description": "Local Hexagon NPU terminal agent for Snapdragon X Elite Windows ARM64",
    "homepage": "https://github.com/NathanL15/Hex-CLI",
    "license": "MIT",
    "notes": "Hex CLI requires Snapdragon X Elite + QAIRT SDK for NPU inference.\nSee https://github.com/NathanL15/Hex-CLI#backend-setup for first-run instructions.",

    "architecture": {
        "arm64": {
            "url": "https://github.com/NathanL15/Hex-CLI/releases/download/v$version/hex-cli-$version-arm64.zip",
            "hash": "REPLACE_WITH_SHA256_OF_RELEASE_ZIP"
        }
    },

    "installer": {
        "script": [
            "& \"$dir\\install.ps1\" -ScoopInstall -InstallDir \"$dir\" -NoStartMenu",
            "Write-Host 'Hex CLI installed via Scoop.'"
        ]
    },

    "uninstaller": {
        "script": [
            "& python \"$dir\\shellai.py\" --uninstall",
            "Write-Host 'Hex CLI uninstalled.'"
        ]
    },

    "bin": [
        ["shellai.cmd", "hexcli"],
        ["shellai.cmd", "shellai"]
    ],

    "shortcuts": [
        ["Hex CLI.cmd", "Hex CLI"]
    ],

    "env_add_path": ".",

    "checkver": {
        "github": "https://github.com/NathanL15/Hex-CLI"
    },

    "autoupdate": {
        "architecture": {
            "arm64": {
                "url": "https://github.com/NathanL15/Hex-CLI/releases/download/v$version/hex-cli-$version-arm64.zip"
            }
        }
    }
}
