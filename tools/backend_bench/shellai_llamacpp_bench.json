{
  "backend": "openai",
  "model": "qwen3-4b-q4_0",
  "temperature": 0.1,
  "timeout_seconds": 600,
  "max_output_tokens": 1024,
  "autopilot_max_output_tokens": 4096,
  "max_agent_steps": 15,
  "tool_output_limit": 12000,
  "use_streaming": true,
  "openai_compatible": {
    "base_url": "http://127.0.0.1:8080/v1",
    "api_key": "local"
  },
  "chat_max_output_tokens": 2048,
  "prompt_stable_prefix": true,
  "prompt_split": false
}
